# Copier ce fichier en .env (ne jamais mettre .env sur GitHub)
NODE_ENV=development
HOTE=127.0.0.1
PORT=3001

# Base de développement : le nom doit finir par _dev pour npm run bd:init
BD_HOTE=127.0.0.1
BD_PORT=3306
BD_UTILISATEUR=root
BD_MOT_DE_PASSE=
BD_NOM=clinique_appels_dev

# Au moins 32 caractères aléatoires (ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SECRET_SESSION= 
DUREE_SESSION_MINUTES=60

# Mot de passe des comptes fictifs créés par npm run bd:init
MOT_DE_PASSE_DEMO=Clinique2026!
